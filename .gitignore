*.spec
!build_spec/*.spec

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Unit test / coverage
.coverage
.coverage.*
.pytest_cache/
htmlcov/
.tox/
.nox/

# Voice Calculator local data & privacy boundaries
# ASR models (never commit model weights or archives)
models/

